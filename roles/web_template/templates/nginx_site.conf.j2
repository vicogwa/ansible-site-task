server {
    listen 80;
    server_name {{ website_domain }} www.{{ website_domain }};

    root {{ app_directory }};
    index index.html index.htm{% if php_enabled %} index.php{% endif %};

    access_log /var/log/nginx/{{ website_domain }}_access.log;
    error_log /var/log/nginx/{{ website_domain }}_error.log;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/xml+rss;

    location / {
        try_files $uri $uri/ /index.html;
    }

{% if php_enabled %}
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php7.4-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }
{% endif %}

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }
}

{% if ssl_enabled %}
server {
    listen 443 ssl http2;
    server_name {{ website_domain }} www.{{ website_domain }};

    ssl_certificate {{ ssl_cert_path }};
    ssl_certificate_key {{ ssl_key_path }};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    root {{ app_directory }};
    index index.html index.htm{% if php_enabled %} index.php{% endif %};

    location / {
        try_files $uri $uri/ /index.html;
    }

{% if php_enabled %}
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php7.4-fpm.sock;
    }
{% endif %}
}
{% endif %}
